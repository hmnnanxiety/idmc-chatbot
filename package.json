{
  "name": "idmc-chatbot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:web": "vite",
    "build": "npm run typecheck && wxt build",
    "build:web": "tsc -b && vite build",
    "zip": "npm run typecheck && wxt zip",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc -b --pretty false && tsc --noEmit -p tsconfig.extension.json",
    "test": "node --test scripts/ui.test.mjs",
    "preview:web": "vite preview",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "clsx": "2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wxt": "0.21.5"
  }
}
