{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
