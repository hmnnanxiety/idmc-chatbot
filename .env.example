# Placeholder until the AI engineer supplies the full POST endpoint.
# Existing contract: POST { "message": "..." } -> { "reply": "..." }.
WXT_CHAT_API_URL=
# Development example: http://127.0.0.1:8000/chat
# Production: use the agreed HTTPS endpoint, then rebuild and reload.
# WXT_ variables are public build configuration. Never put provider API keys here.

# Full-page web deployment URL, used by the extension maximize button.
# In development this defaults to http://localhost:5173.
# Set the real HTTPS subdomain before building the production extension.
WXT_WEB_APP_URL=

# Web POST endpoint. Empty uses same-origin /api/chat.
# Development Vite proxies /api/chat to http://127.0.0.1:8000/chat.
# For deployment, configure a reverse proxy or an HTTPS API with CORS for the web origin.
VITE_CHAT_API_URL=
